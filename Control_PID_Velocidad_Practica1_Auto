#include <Encoder.h>

// ENCODER
const int encoderA = 2;
const int encoderB = 3;

Encoder encoder(encoderA, encoderB);

const float PPR = 512.0;
long posicionAnterior = 0;

// L298N
const int pinPWM = 5;
const int pinIN1 = 7;
const int pinIN2 = 8;

// RPM
float rpmDeseada = 1100.0;
float rpmActual = 0.0;

float rpmMedida = 0.0;
float alpha = 0.5;

// PID
float Kp = 0.1;
float Ki = 0.002;
float Kd = 0.001;

float error = 0.0;
float errorAnterior = 0.0;

float integral = 0.0;
float derivada = 0.0;

float salidaPID = 0.0;

// PWM
float pwm = 120.0;

// TIEMPO
unsigned long tiempoAnterior = 0;

const float dt = 0.1;   // 100 ms

void setup() {

  Serial.begin(9600);

  // Encoder
  posicionAnterior = encoder.read();

  // L298N
  pinMode(pinPWM, OUTPUT);
  pinMode(pinIN1, OUTPUT);
  pinMode(pinIN2, OUTPUT);

  // Dirección del motor
  digitalWrite(pinIN1, HIGH);
  digitalWrite(pinIN2, LOW);

  // PWM inicial
  analogWrite(pinPWM, (int)pwm);

  tiempoAnterior = millis();
}

void loop() {

  unsigned long tiempoActual = millis();

  // Ejecutar PID cada 100 ms
  if (tiempoActual - tiempoAnterior >= 100) {

    // 1. LEER ENCODER
    long posicionActual = encoder.read();
    long cuentas = posicionActual - posicionAnterior;
    posicionAnterior = posicionActual;

    // 2. CALCULAR RPM
    rpmMedida = (cuentas * 60.0) / (PPR * dt);
    if (rpmActual == 0.0) {
      rpmActual = rpmMedida;
    } else {
      rpmActual = (alpha * rpmMedida) + ((1.0 - alpha) * rpmActual);
    }

    // 3. CALCULAR ERROR
    error = rpmDeseada - rpmActual;

    // 4. TERMINO INTEGRAL
    integral = integral + (error * dt);

    // Evitar acumulación excesiva
    if (integral > 500) {
      integral = 500;
    }

    if (integral < -500) {
      integral = -500;
    }

    // 5. TERMINO DERIVATIVO
    derivada = (error - errorAnterior) / dt;

    // 6. PID
    salidaPID =
        (Kp * error) +
        (Ki * integral) +
        (Kd * derivada);

    // 7. ACTUALIZAR PWM
    pwm = pwm + salidaPID;

    // Limitar PWM
    if (pwm > 255) {
      pwm = 255;
    }

    if (pwm < 0) {
      pwm = 0;
    }

    // Aplicar PWM
    analogWrite(pinPWM, (int)pwm);

    // 8. GUARDAR ERROR
    errorAnterior = error;

    // 9. SERIAL PLOTTER
    Serial.print("RPM_Deseada:");
    Serial.print(rpmDeseada);

    Serial.print("\t");

    Serial.print("RPM_Actual:");
    Serial.print(rpmActual);

    Serial.print("\t");

    Serial.print("PWM:");
    Serial.println(pwm);

    // 10. ACTUALIZAR TIEMPO
    tiempoAnterior = tiempoActual;
  }
}
